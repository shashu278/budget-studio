# Gemini API Key (Required for AI Smart Features, Receipt Scanner, Chat Advisor & Opportunity Interceptor).
# Also gates the /api/gemini/* endpoints: once VITE_SUPABASE_URL/ANON_KEY
# below are set, those endpoints require a signed-in user's session
# token, so this key can't be spent by anonymous requests to the deployed URL.
GEMINI_API_KEY=

# Supabase Auth + cross-device sync (optional). Use the anon/public key
# only — never the service_role secret, which must never be shipped to a
# browser. Set these to the SAME project your other BudgetIQ app (if any)
# uses, and run supabase/migrations/0001_schema_and_rls.sql then
# supabase/migrations/0002_studio_compat.sql once in that project's SQL
# Editor, so both apps read/write the same authenticated, RLS-protected rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

